      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agritrace.mobile",
      "icon": "./assets/icon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "9594d9bc-52e5-48a5-b321-9ff3634e1fbe"
      }
    }
  }
}
