{
  "expo": {
    "name": "AgriTrace",
    "slug": "agritrace-mobile",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.agritrace.mobile",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.agritrace.mobile",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#DC4545",
      "defaultChannel": "agritrace-critical-alerts",
      "sounds": [
        "./assets/sounds/critical_alarm.wav"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "peripheral",
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow $(PRODUCT_NAME) to connect to bluetooth devices"
        }
      ],
      "expo-audio",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "9594d9bc-52e5-48a5-b321-9ff3634e1fbe"
      }
    }
  }
}
